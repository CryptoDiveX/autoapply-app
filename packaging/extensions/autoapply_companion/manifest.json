{
  "manifest_version": 3,
  "name": "AutoApply Companion — Setup & Validation Guide",
  "version": "1.0.0",
  "description": "Preloaded side-panel guide that walks you through connecting OpenRouter, ChatGPT, CapSolver, Gmail App Passwords, Teal, and LinkedIn, and validates each step in one click.",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:19299/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AutoApply Companion Guide",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dialog_guard_main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": true
    }
  ]
}
